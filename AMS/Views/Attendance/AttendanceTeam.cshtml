@using System.Security.Claims
@model List<Entity.Models.User>;
@{
    ViewData["Title"] = "Team Attendance Page";
    int currentUserId = 0;
    var nameIdentifierClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    if (!string.IsNullOrEmpty(nameIdentifierClaim) && int.TryParse(nameIdentifierClaim, out int parsedId))
    {
        currentUserId = parsedId;
    }
}
<div class="content" id="attendanceTeam">
    <div class="row mx-sm-3 mx-2 pt-2">
        <div class="col-12 my-2">
            <h3 class="sitetxtcolor">Attendance</h3>
        </div>
        <div class="col-12 h5 text-primary">
            Team
        </div>
        <div class="col-12 d-xxl-flex justify-content-between align-items-end">
            <div class="mb-3 d-flex flex-wrap gap-3">
                <div>
                    <label for="teamMonth" class="form-label fw-semibold">Select Month</label>
                    <select class="form-select" id="teamMonth" style="width: 150px;">
                        @for (int i = 1; i < 13; i++)
                        {
                            <option value="@i">@(new DateTime(2025, i, 1).ToString("MMMM"))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="teamYear" class="form-label fw-semibold">Select Year</label>
                    <select class="form-select" id="teamYear" style="width: 150px;">
                        @for (int i = -1; i <= 1; i++)
                        {
                            var currentYear = DateTime.Now.Year;
                            var year = DateTime.Now.AddYears(i).Year;
                            if (year == currentYear)
                            {
                                <option value="@year" selected>@year</option>
                            }
                            else
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <button class="btn sitebgcolor w-100" onclick="getTeamAttendanceTable()" type="button">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </div>
                <div class="d-flex align-items-end">
                    <button class="btn siteoutlinebtn w-100" onclick="resetTeamAttendanceTable()" type="button">
                        <i class="bi bi-arrow-repeat me-1"></i> Reset
                    </button>
                </div>
            </div>
            <div class="d-flex flex-wrap mb-3">
                Present <div style="width: 15px;" class="bg-success-subtle m-1 me-2"></div>
                Absent <div style="width: 15px;" class="bg-danger-subtle m-1 me-2"></div>
                Half Present <div style="width: 15px;" class="bg-info-subtle m-1 me-2"></div>
                Today <div style="width: 15px;" class="bg-warning-subtle m-1 me-2"></div>
                Weekend,Holiday <div style="width: 15px;" class="bg-secondary-subtle m-1 me-2"></div>
            </div>
        </div>
        @if (Model.Count > 0)
        {
            <div class="col-12" id="teamAttendanceTable">
                <div class="attendance-table-wrapper">
                    <table class="table table-bordered mt-1">
                        <thead>
                            <tr id="teamAttendanceHeaderRow"></tr>
                        </thead>
                        <tbody id="teamAttendanceBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="col-12 d-flex justify-content-end">
                <a class="btn sitebgcolor" id="saveTeamAttendanceBtn" onclick="saveTeamAttendance()">Submit</a>
            </div>
        }
        else
        {
            <p>No employee assigned to you.</p>
        }
    </div>
</div>

@section scripts {
    <script>
        let currentUserId =@currentUserId;
        let teamUsers =@Html.Raw(Json.Serialize(Model.Select(x => new { id = x.UserId, name = x.Name }).OrderBy(x => x.id)));
        let currentRole =@Html.Raw(Json.Serialize(role));
    </script>
    <script src="~/js/TeamAttendance.js">
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}