@using Entity.ViewModels
@model Entity.ViewModels.UserMonthlyAttendanceVM;
<h4>@(new DateTime(2025, Model.Month, 1).ToString("MMM"))-@Model.Year</h4>
<div class="attendance-table-wrapper">
    <table class="table table-bordered">
    <thead>
        <tr>
            @foreach (UserAttendanceVM data in Model.AttendanceRecords)
            {
                <th class="text-center">
                    <div>
                        @data.Date.Day.ToString("D2")
                    </div>
                    <div>
                        @data.Day![0]
                    </div>
                </th>
            }   
        </tr>
    </thead>
    <tbody>
        <tr>
            @foreach (UserAttendanceVM data in Model.AttendanceRecords)
            {
                bool futureDates=DateTime.Now.Date<data.Date.ToDateTime(TimeOnly.MinValue);
                bool clickable=!futureDates && !data.IsHoliday!.Value;
                <td class="text-center @(futureDates?"not-clickable":"") @(data.IsHoliday!.Value?"leave-days":"") @(clickable?"clickable":"")" onclick="showAttendanceBox(this)"
                data-userid="@Model.UserId" data-date="@data.Date.ToString("yyyy-MM-dd")">
                    <div style="height:25px;"> 
                        @if((data.Day!="Saturday" && data.Day!="Sunday") && data.IsHoliday!.Value){
                            <p>H</p>
                        }
                    </div>
                </td>
            }
        </tr>
    </tbody>
</table>
</div>
<div class="attendance-popup d-none" id="attendanceBox">
    <button class="btn btn-sm btn-success">Present</button>
    <button class="btn btn-sm btn-danger">Absent</button>
    <button class="btn btn-sm btn-secondary">Half Present</button>
</div>