@using BLL.Helpers
@using Entity.Enums
@using Entity.ViewModels;
@using System.Security.Claims;
@model Entity.ViewModels.UserMonthlyAttendanceVM;
@{
    var role=User.FindFirst(ClaimTypes.Role)?.Value;
}
<p class="text-danger mb-1 d-none" id="approvedTitle">Today's attendance has been submitted by your Reporting Person. Please contact him/her now in case of any corrections.</p>
<div class="d-sm-flex justify-content-between align-items-center">
    <h6 class="user-title">@(new DateTime(2025, Model.Month, 1).ToString("MMM"))-@Model.Year</h6>
    @{
        double halfPresentDays=(Model.AttendanceRecords.Where(x=>x.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.HalfPresent)).Count()/2.0);
        int totalDays=Model.AttendanceRecords.Where(x=>!(bool)x.IsHoliday && Model.UserCreatedAt!.Value.Date<=x.Date.ToDateTime(TimeOnly.MinValue)).Count();
        double presentDays=Model.AttendanceRecords.Where(x=>x.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Present)).Count()+halfPresentDays;
        double absentDays=Model.AttendanceRecords.Where(x=>x.Date.ToDateTime(TimeOnly.MinValue)<DateTime.Now.Date && Model.UserCreatedAt!.Value.Date<=x.Date.ToDateTime(TimeOnly.MinValue) && !(bool)x.IsHoliday && (x.Status==null || x.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Absent))).Count() + halfPresentDays
        +Model.AttendanceRecords.Where(x=>x.Date.ToDateTime(TimeOnly.MinValue)>=DateTime.Now.Date && x.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Absent)).Count();
    }
    <h6>Present <span class="badge bg-success">@presentDays</span> Absent <span class="badge bg-danger">@absentDays</span> Total <span class="badge bg-secondary">@totalDays</span> days</h6>
</div>
<div class="attendance-table-wrapper">
    <table class="table table-bordered">
    <thead>
        <tr>
            @foreach (UserAttendanceVM data in Model.AttendanceRecords)
            {
                <th class="text-center">
                    <div>
                        @data.Date.Day.ToString("D2")
                    </div>
                    <div>
                        @data.Day![0]
                    </div>
                </th>
            }   
        </tr>
    </thead>
    <tr>
            @foreach (UserAttendanceVM data in Model.AttendanceRecords)
            {
                bool clickable=true;
                bool blockDay=data.IsHoliday!.Value || Model.UserCreatedAt!.Value.Date>data.Date.ToDateTime(TimeOnly.MinValue);
                if(role!=EnumHelper.RoleToDbString(RoleEnum.Admin)){
                    clickable = DateTime.Now.Date==data.Date.ToDateTime(TimeOnly.MinValue);
                    if((data.IsApproved!=null && (bool)data.IsApproved))
                    clickable = false;
                }
                else{
                    clickable=!blockDay;
                }
                if(data.IsHoliday!.Value)
                    clickable=false;
                if(DateTime.Now.Date<data.Date.ToDateTime(TimeOnly.MinValue))
                clickable=false;
                bool satOrSun=data.Day==DayOfWeek.Saturday.ToString() || data.Day==DayOfWeek.Sunday.ToString();
                <td class="text-center p-0 @(blockDay?"leave-days":"") @(clickable?"clickable":"not-clickable")"
                data-userid="@Model.UserId" data-date="@data.Date.ToString("yyyy-MM-dd")" onclick="showDropdown(this)">
                    <div style="height:41px;"> 
                            @if(!satOrSun && data.IsHoliday!.Value){
                                <div class="h-100 d-flex justify-content-center align-items-center">
                                    <span>H</span>
                                </div>
                            }
                            @if(data.Status==null && !blockDay && DateTime.Now.Date>data.Date.ToDateTime(TimeOnly.MinValue) && !satOrSun){
                                data.Status=EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Absent);
                                data.IsApproved=false;
                            }
                            @{
                                bool PresentApproved=data.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Present) && data.IsApproved!=null && (bool)data.IsApproved,Present=data.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Present) && (data.IsApproved==null || !(bool)data.IsApproved);
                                bool AbsentApproved=data.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Absent)  && data.IsApproved!=null && (bool)data.IsApproved,Absent=data.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.Absent)  && (data.IsApproved==null || !(bool)data.IsApproved);
                                bool HalfPresentApproved=data.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.HalfPresent) && data.IsApproved!=null && (bool)data.IsApproved,HalfPresent=data.Status==EnumHelper.AttendanceToDbString(AttendanceStatusEnum.HalfPresent) && (data.IsApproved==null || !(bool)data.IsApproved);
                            }
                            @if(clickable){
                                <div class="h-100 d-flex justify-content-center align-items-center">
                                    <select class="h-100 w-100 text-center @(data.Status==null?"today-not-filled":"") 
                                    @(PresentApproved?"present-day-approved approved":"")
                                    @(Present?"present-day":"")
                                    @(AbsentApproved?"absent-day-approved approved":"")
                                    @(Absent?"absent-day":"")
                                    @(HalfPresentApproved?"halfpresent-day-approved approved":"")
                                    @(HalfPresent?"halfpresent-day":"")" 
                                    style="border:none;" asp-for="AttendanceRecords[Model.AttendanceRecords.IndexOf(data)].Status">
                                        <option class="" value="" hidden></option>
                                        <option class="present-day" value="Present">P</option>
                                        <option class="absent-day" value="Absent">A</option>
                                        <option class="halfpresent-day" value="Half Present">HP</option>
                                    </select>
                                </div>
                            }
                            else if(data.Status!=null){
                                <div class="h-100 d-flex justify-content-center align-items-center 
                                @(PresentApproved?"present-day-approved":"")
                                @(Present?"present-day":"")
                                @(AbsentApproved?"absent-day-approved":"")
                                @(Absent?"absent-day":"")
                                @(HalfPresentApproved?"halfpresent-day-approved":"")
                                @(HalfPresent?"halfpresent-day":"")">
                                    <span>@string.Concat(data.Status.Split(" ").Select(x=>x[0]))</span>
                                </div>
                            }   
                    </div>
                </td>
            }
        </tr>
    </tbody>
</table>
</div>