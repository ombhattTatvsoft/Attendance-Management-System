@model Entity.Models.User;
@{
    ViewData["Title"] = "Self Regularize Page";
}
<div class="content" id="regularizeSelf">
    <div class="row mx-sm-3 mx-2 pt-2">
        <div class="col-12 my-2 d-flex align-items-center justify-content-between">
            <h3 class="sitetxtcolor">Regularize</h3>
            <a class="btn sitebgcolor" data-bs-toggle="modal" data-bs-target="#upsertRegularize"> + Add</a>
        </div>
        <div class="col-12 h5 text-primary">
            Self
        </div>
        <div class="col-12 d-xxl-flex justify-content-between align-items-center">
            <div class="mb-3 d-flex flex-wrap gap-3 align-items-center">
                <div class="form-floating">
                    <input id="" class="form-control" type="date" />
                    <label>From Date</label>
                </div>
                <div class="form-floating">
                    <input id="" class="form-control" type="date" />
                    <label>To Date</label>
                </div>
                <div class="form-floating">
                    <select class="form-select">
                        <option value="All" selected>All</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <label>Status</label>
                </div>
                <div>
                    <button class="btn sitebgcolor me-2" type="button">Search</button>
                    <button class="btn siteoutlinebtn" type="button">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>


@* Add modal *@
<div class="modal fade" id="upsertRegularize" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-dialog-centered">
        <form id="upsertRegularizeForm" class="w-100">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Regularize Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="UserId" value="@Model.UserId">
                    <div class="form-floating mb-3">
                        <input type="date" class="form-control" name="AttendanceDate" id="attendanceDate">
                        <span class="text-danger"></span>
                        <label for="floatingInput">Date</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select class="form-select" disabled name="SubmittedAttendance" id="submittedAttendance">
                        </select>
                        <label>Submitted Attendance</label>
                    </div>
                    <div class="form-floating">
                        <select class="form-select" id="correctAttendance" name="CorrectAttendance">
                            <option value="" hidden></option>
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Half Present">Half Present</option>
                        </select>
                        <label>Correction to be done</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn sitebgcolor">Add</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        var createdAt=@Html.Raw(Json.Serialize(Model.CreatedAt));
        createdAt=createdAt.split('T')[0];
        var userId=@Model.UserId;
    </script>
    <script src="~/js/RegularizeSelf.js">
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}