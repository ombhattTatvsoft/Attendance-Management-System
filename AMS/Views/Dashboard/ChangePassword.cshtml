@model Entity.ViewModels.ChangePasswordVM;
@{
    ViewData["Title"] = "Change Password";
}
<div class="content">
    <div class="row mx-sm-5 mx-2 pt-5">
        <div class="col-sm-6">
            <h3>Change Password</h3>
        </div>
        <div class="row">
            <form id="myform" asp-action="ChangePassword" method="post" class="ms-md-5 ps-md-5 mt-4">
                <div class="col-xl-4 col-sm-6 ms-md-5 ">
                    <p class="text-body-tertiary">Enter a new password to update your account credentials</p>
                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="CurrentPassword" type="password" class="form-control" id="currentPassword" placeholder="">
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        <label>Current Password</label>
                        <i class="position-absolute passwordEyeIcon fa-regular fa-eye-slash" id="eyeicon1"
                            style="cursor: pointer;" onclick="togglePassword('currentPassword','eyeicon1')"></i>
                    </div>
                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" placeholder="">
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <label>New Password</label>
                        <i class="position-absolute passwordEyeIcon fa-regular fa-eye-slash" id="eyeicon2"
                            style="cursor: pointer;" onclick="togglePassword('newPassword','eyeicon2')"></i>
                    </div>
                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" id="cnewPassword" placeholder="">
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        <label>Confirm New Password</label>
                        <i class="position-absolute passwordEyeIcon fa-regular fa-eye-slash" id="eyeicon3"
                            style="cursor: pointer;" onclick="togglePassword('cnewPassword','eyeicon3')"></i>
                    </div>
                    <button class="btn sitebgcolor my-2" type="submit">Submit</button>
                    <a asp-action="Index" class="btn siteoutlinebtn my-2 ms-2">Cancel</a>
                </div>
            </form>
        </div>



    </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}