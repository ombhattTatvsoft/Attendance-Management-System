@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard Page";
    var role = User?.FindFirst(ClaimTypes.Role)?.Value.ToString();
}

<div class="content" id="dashboard">
    <div class="row mx-sm-3 mx-2 pt-2">
        <div class="col-12 my-2">
            <h3 class="sitetxtcolor">Dashboard</h3>
        </div>

        <div class="col-xxl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0 rounded-4">
                <div class="card-header bg-primary text-white fw-semibold rounded-top-4">
                    @(role == "Admin" ? "Today's Attendance" : "Monthly Leaves")
                </div>
                <div class="card-body d-flex justify-content-between">
                    @if (role == "Admin")
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Employee</p>
                            <p class="h6 mb-0">13</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Present</p>
                            <p class="h6 mb-0">12</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Absent</p>
                            <p class="h6 mb-0">1</p>
                        </div>
                    }
                    else
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Absent Days</p>
                            <p class="h6 mb-0">3</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Half Days</p>
                            <p class="h6 mb-0">3</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Days</p>
                            <p class="h6 mb-0">4.5</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xxl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0 rounded-4">
                <div class="card-header bg-success text-white fw-semibold rounded-top-4">
                    Public Holidays
                </div>
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <p class="mb-1 fw-bold text-muted">Month</p>
                        <p class="h6 mb-0">June</p>
                    </div>
                    <div>
                        <p class="mb-1 fw-bold text-muted">Holiday</p>
                        <p class="h6 mb-0">3</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xxl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0 rounded-4">
                <div class="card-header bg-warning text-white fw-semibold rounded-top-4">
                    @(role == "Admin" ? "Users" : "Present Days")
                </div>
                <div class="card-body d-flex justify-content-between">
                    @if (role == "Admin")
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Users</p>
                            <p class="h6 mb-0">14</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Managers</p>
                            <p class="h6 mb-0">6</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Employees</p>
                            <p class="h6 mb-0">7</p>
                        </div>
                    }
                    else
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Days</p>
                            <p class="h6 mb-0">22</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Leave Days</p>
                            <p class="h6 mb-0">3</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Present Days</p>
                            <p class="h6 mb-0">19</p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>