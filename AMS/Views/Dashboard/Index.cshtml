@model Entity.ViewModels.DashboardVM;
@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard Page";
    var role = User?.FindFirst(ClaimTypes.Role)?.Value.ToString();
    var currentUserId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    double
    fullAbsentDays = Model.UserDashboard?.AttendanceRecords.Where(x => x.Date.ToDateTime(TimeOnly.MinValue) <=
    DateTime.Now.Date
    && Model.UserDashboard.UserCreatedAt!.Value.Date <= x.Date.ToDateTime(TimeOnly.MinValue) && !(bool)x.IsHoliday &&
    (x.Status == null || x.Status == "Absent")).Count() ?? 0;
    double halfDays = (Model.UserDashboard?.AttendanceRecords.Where(x => x.Status == "Half Present").Count() / 2.0) ?? 0;
    double holidays = Model.UserDashboard?.AttendanceRecords.Where(x => x.IsHoliday == true && x.Day != "Saturday" &&
    x.Day != "Sunday").Count() ?? 0;
    double totalDays = Model.UserDashboard?.AttendanceRecords.Where(x => !(bool)x.IsHoliday &&
    Model.UserDashboard.UserCreatedAt!.Value.Date <= x.Date.ToDateTime(TimeOnly.MinValue)).Count() ?? 0;
    double presentDays = Model.UserDashboard?.AttendanceRecords.Where(x => x.Status == "Present").Count() + halfDays ?? 0;
}

<div class="content" id="dashboard">
    <div class="row mx-sm-3 mx-2 pt-2">
        <div class="col-12 my-2">
            <h3 class="sitetxtcolor">Dashboard</h3>
        </div>

        <div class="col-xxl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0 rounded-4">
                <div class="card-header bg-primary text-white fw-semibold rounded-top-4">
                    @(role == "Admin" ? "Today's Attendance" : "Monthly Leaves")
                </div>
                <div class="card-body d-flex justify-content-between gap-1">
                    @if (role == "Admin")
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Employee</p>
                            <p class="h6 mb-0">@Model.AdminDashboard?.TotalEmployee</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Present</p>
                            <p class="h6 mb-0">@Model.AdminDashboard?.PresentEmployee</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Absent</p>
                            <p class="h6 mb-0">@Model.AdminDashboard?.AbsentEmployee</p>
                        </div>
                    }
                    else
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Absent Days</p>
                            <p class="h6 mb-0">@fullAbsentDays</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Half Days</p>
                            <p class="h6 mb-0">@halfDays</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Days</p>
                            <p class="h6 mb-0">@(fullAbsentDays + halfDays)</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xxl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0 rounded-4">
                <div class="card-header bg-success text-white fw-semibold rounded-top-4">
                    Public Holidays
                </div>
                <div class="card-body d-flex justify-content-between gap-1">
                    <div>
                        <p class="mb-1 fw-bold text-muted">Month</p>
                        <p class="h6 mb-0">@DateTime.Now.ToString("MMMM")</p>
                    </div>
                    <div>
                        <p class="mb-1 fw-bold text-muted">Holiday</p>
                        <p class="h6 mb-0">@holidays</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xxl-4 col-md-6 mb-4">
            <div class="card shadow h-100 border-0 rounded-4">
                <div class="card-header bg-warning text-white fw-semibold rounded-top-4">
                    @(role == "Admin" ? "Users" : "Present Days")
                </div>
                <div class="card-body d-flex justify-content-between gap-1">
                    @if (role == "Admin")
                    {
                        <div>
                            <div>
                                <p class="mb-1 fw-bold text-muted">Total <span
                                        class="h6 text-dark">@(Model.AdminDashboard?.Managers +
                                                                            Model.AdminDashboard?.SeniorManagers + Model.AdminDashboard?.Employees + 1)</span>
                            </p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Managers <span
                                    class="h6 text-dark">@Model.AdminDashboard?.Managers</span></p>
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-end">
                        <div>
                            <p class="mb-1 fw-bold text-muted">Senior Managers <span
                                    class="h6 text-dark">@Model.AdminDashboard?.SeniorManagers</span></p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Employees <span
                                    class="h6 text-dark">@Model.AdminDashboard?.Employees</span></p>
                        </div>
                    </div>
                                        }
                    else
                    {
                        <div>
                            <p class="mb-1 fw-bold text-muted">Total Days</p>
                            <p class="h6 mb-0">@totalDays</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Leave Days</p>
                            <p class="h6 mb-0">@(fullAbsentDays + halfDays)</p>
                        </div>
                        <div>
                            <p class="mb-1 fw-bold text-muted">Present Days</p>
                            <p class="h6 mb-0">@presentDays</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mb-3 d-flex flex-wrap gap-3">
            <select class="form-select" style="width: 200px;" id="selectedUserId">
                @if (role != "Admin")
                {
                    <option value="@currentUserId">Self</option>
                }
                @foreach (var user in Model.Team)
                {
                    <option value="@user.UserId">@(user.Name)(@user.Role.RoleName)</option>
                }
            </select>
            <select class="form-select" id="myMonth" style="width: 150px;">
                @for (int i = 1; i < 13; i++)
                {
                    <option value="@i">@(new DateTime(2025, i, 1).ToString("MMMM"))</option>
                }
            </select>
            <select class="form-select" id="myYear" style="width: 150px;">
                <option value="2025" selected>2025</option>
            </select>
            <div class="d-flex gap-3">
                <button class="btn sitebgcolor" onclick="fetchGraph()" type="button">Search</button>
                <button class="btn siteoutlinebtn" type="button">Reset</button>
            </div>
        </div>

        <div id="chart_div"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard.js"></script>
}