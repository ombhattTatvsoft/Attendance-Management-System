@model Entity.ViewModels.UpsertUserVM
@using System.Security.Claims
@using Entity.Enums
@{
  ViewData["Title"] = "Profile";
  ViewData["selected"] = "dashboard";
}
<div class="content">
  <div class="row mx-sm-5 mx-2 pt-5">
    <div class="col-sm-6">
      <h3>My Profile</h3>
    </div>
    <form class="bg-white p-3 shadow-lg rounded" asp-action="MyProfile" method="post" enctype="multipart/form-data">
      <div class="">
        <div class="d-flex align-items-center justify-content-between w-100 mt-3">
          <div class="d-flex align-items-center">
            <img src="~/images/Default_pfp.svg.png" alt="" class="ms-3 img-fluid rounded-circle profiledivimg"
              style="object-fit: cover;">
            <div class="ms-2">
              <h3>@Model.Name</h3>
              <h6 class="me-3 d-none d-sm-block text-muted">Joining Date : <span
                  class="h5 text-dark">@Model.CreatedAt?.ToString("dd MMM yyyy")</span></h6>
            </div>
          </div>
        </div>
      </div>
      <div class="row mt-3 px-3">

        <input type="hidden" asp-for="UserId">
        <div class="col-md-6">
          <div class="form-floating mb-3">
            <input asp-for="Name" type="text" class="form-control" id="floatingInput" placeholder="">
            <label for="floatingInput">Name</label>
            <span asp-validation-for="Name" class="text-danger"></span>
          </div>
        </div>

        <div class="col-md-6">
          <div class="form-floating mb-3">
            <input asp-for="Email" type="email" class="form-control" id="floatingInput" placeholder="">
            <label for="floatingInput">Email</label>
            <span asp-validation-for="Email" class="text-danger"></span>
          </div>
        </div>

        <input type="hidden" asp-for="RoleId">
        <div class="col-md-6">
          <div class="form-floating mb-3">
            <input type="text" class="form-control" id="floatingInput"
              value="@Enum.GetName(typeof(RoleEnum), Model.RoleId)" readonly>
            <label for="floatingInput">Role</label>
          </div>
        </div>

        <input type="hidden" asp-for="DepartmentId">
        @if (Model.DepartmentId != 0)
        {
          <div class="col-md-6">
            <div class="form-floating mb-3">
              <input type="text" class="form-control" id="floatingInput"
                value="@Model.Departments.Where(x => x.DepartmentId == Model.DepartmentId).Select(x => x.DepartmentName).FirstOrDefault()"
                readonly>
              <label for="floatingInput">Department</label>
            </div>
          </div>
        }

        <input type="hidden" asp-for="ManagerId">
        @if (Model.ManagerId != 0)
        {
          <div class="col-md-6">
            <div class="form-floating mb-3">
              <input type="text" class="form-control" id="floatingInput" asp-for="@Model.ManagerName" readonly>
              <label for="floatingInput">Reporting Person</label>
            </div>
          </div>
        }

        <input type="hidden" asp-for="CreatedAt">
        <div class="d-flex justify-content-end align-items-center gap-3 mb-3">
          <button class="btn sitebgcolor" type="submit">Update</button>
          <a class="btn siteoutlinebtn" asp-action="Index">Cancel</a>
        </div>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}