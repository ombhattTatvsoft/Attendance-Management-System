@model Entity.ViewModels.ResetPasswordVM;
@{
    ViewData["Title"] = "Reset Password Page";
}
<div class="container-fluid d-flex align-items-center justify-content-center vh-100">
    <div class="d-flex col-xxl-4 col-xl-6 col-md-8 col-11 flex-column align-items-center justify-content-center card bg-white rounded-4">
        <h4 class="mb-2 mt-4">Reset Password</h4>
        <div class="col-10 mb-4">
            <form asp-controller="Home" asp-action="ResetPassword" method="post">
                <div class="form-floating mb-3">
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="">
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <label>New Password</label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <label>Confirm Password</label>
                </div>
                <input asp-for="ResetCode" class="d-none">
                <div class="d-flex justify-content-between align-items-center">
                    <a class="links" asp-controller="Home" asp-action="Index">Back to Login</a>
                    <button type="submit" class="btn sitebgcolor">Send</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}