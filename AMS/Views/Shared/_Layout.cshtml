<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AMS.styles.css" asp-append-version="true" />
    @* toastr *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
</head>

<body>
    @using System.Security.Claims;
    @inject IHttpContextAccessor HttpContextAccessor;
    @{
        var user = HttpContextAccessor?.HttpContext?.User;
        var role = user?.FindFirst(ClaimTypes.Role)?.Value.ToString();
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <div class="bg-body-tertiary" style="min-height: 100vh;">
        @if (user.Identity.IsAuthenticated)
        {
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
                <div class="container-fluid d-flex justify-content-between">
                    <div class="d-flex align-items-center">
                        <a class="navbar-brand links">AMS</a>
                        <i class="bi bi-list fs-4" style="color: white;" onclick="toggleSidebar()"></i>
                    </div>
                    <div id="renderUser"></div>
                </div>
            </nav>
            <aside class="sidebar visible position-fixed vh-100 bg-white" id="mySidebar">
                <ul class="p-2 d-flex flex-column">
                    <li class="sidebaroptions" id="dashboard">
                        <a asp-controller="Dashboard" asp-action="Index"><i
                                class="fa-solid fa-table-cells-large"></i><span>Dashboard</span></a>
                    </li>
                    @if (role == "Admin" || role == "Manager")
                    {
                        <li class="sidebaroptions" id="user">
                            <a asp-controller="User" asp-action="Index"><i class="fa-solid fa-users"></i><span>Users</span></a>
                        </li>
                    }
                    <li class="sidebaroptions" id="attendance">
                        <a asp-controller="Attendance" asp-action="Index"><i
                                class="fa-solid fa-clipboard-user"></i><span>Attendance</span></a>
                    </li>
                    <li class="sidebaroptions" id="holiday">
                        <a asp-controller="Holiday" asp-action="Index"><i
                                class="fa-solid fa-calendar"></i><span>Holiday</span></a>
                    </li>
                    @if (role == "Admin" || role == "Manager")
                    {
                        <li class="sidebaroptions" id="reportAnalytics">
                            <a asp-controller="ReportAnalytics" asp-action="Index"><i
                                    class="fa-solid fa-chart-pie"></i><span>Report & Analytics</span></a>
                        </li>
                    }
                </ul>
            </aside>
        }
        <main role="main" class="main-div @(user.Identity.IsAuthenticated?"main-margin":"")" id="mainBody">
            <partial name="_Notification" />
            @RenderBody()
        </main>
        <!-- logout modal -->
        <div class="modal fade" id="logout" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content w-75 p-3">
                    <div class=" d-flex flex-column align-items-center">

                        <p class="text-body-tertiary">Are you sure you want to Logout?</p>
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Logout" class="btn sitebgcolor">Yes</a>
                        <a type="button" class="btn siteoutlinebtn" data-bs-dismiss="modal">No</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            const sidebarMediaQuery = window.matchMedia('(min-width: 993px)');
            sidebarMediaQuery.addEventListener('change', () => {
                $("#mySidebar").toggleClass("hidden visible");
                $("#mainBody").toggleClass("main-margin");
            });
            $.ajax({
                url: "@Url.Action("GetUserData", "Dashboard")",
                type: "GET",
                success: function (response) {
                    $("#renderUser").html(response);
                }
            });
            $(".sidebaroptions").removeClass("activesidebar");
            document.getElementById('@ViewData["selected"]').classList.add("activesidebar");
        });
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
