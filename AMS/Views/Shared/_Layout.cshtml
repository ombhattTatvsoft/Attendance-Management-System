<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    @* data tables *@
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.3/css/buttons.dataTables.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AMS.styles.css" asp-append-version="true" />
    @* toastr *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
</head>

<body>
    @using System.Security.Claims;
    @using BLL.Helpers
    @using Entity.Enums;
    @{
        var user = User;
        var role = user?.FindFirst(ClaimTypes.Role)?.Value.ToString();
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <div class="bg-body-tertiary" style="min-height: 100vh;">
        @if (user.Identity.IsAuthenticated)
        {
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
                <div class="container-fluid d-flex justify-content-between">
                    <div class="d-flex align-items-center">
                        <a class="navbar-brand links">AMS</a>
                        <i class="bi bi-list fs-4" style="color: white;" onclick="toggleSidebar()"></i>
                    </div>
                    <div id="renderUser"></div>
                </div>
            </nav>
            <aside class="sidebar visible position-fixed vh-100 bg-white" id="mySidebar">
                <ul class="p-2 d-flex flex-column">
                    <li class="sidebaroptions" id="dashboard">
                        <a asp-controller="Dashboard" asp-action="Index"><i
                                class="fa-solid fa-table-cells-large"></i><span>Dashboard</span></a>
                    </li>
                    @if (role == RoleHelper.ToDbString(RoleEnum.Admin))
                    {
                        <li class="sidebaroptions" id="user">
                            <a asp-controller="User" asp-action="Index"><i class="fa-solid fa-users"></i><span>Users</span></a>
                        </li>
                    }
                    <li class="sidebaroptions">
                        <a href="javascript:void(0);" onclick="toggleSubMenu('attendanceSubMenu')">
                            <i class="fa-solid fa-clipboard-user"></i><span>Attendance</span>
                        </a>
                        <ul class="submenu ps-3 d-none" id="attendanceSubMenu">
                            @if (role != RoleHelper.ToDbString(RoleEnum.Admin))
                            {
                                <li id="attendanceSelf">
                                    <a asp-controller="Attendance" asp-action="Index">Self</a>
                                </li>
                            }
                            <li id="attendanceTeam">
                                <a asp-controller="Attendance" asp-action="AttendanceTeam">Team</a>
                            </li>
                            @* <li>
                                <a href="javascript:void(0);" onclick="toggleSubMenu('regularizeSubMenu')">Regularize</a>
                                <ul class="submenu ps-3 d-none" id="regularizeSubMenu">
                                    @if (role != RoleHelper.ToDbString(RoleEnum.Admin))
                                    {
                                        <li id="regularizeSelf">
                                            <a asp-controller="Attendance" asp-action="RegularizeSelf">Self</a>
                                        </li>
                                    }
                                    <li id="regularizeTeam">
                                        <a asp-controller="Attendance" asp-action="RegularizeTeam">Team</a>
                                    </li>
                                </ul>
                            </li> *@
                        </ul>
                    </li>
                    <li class="sidebaroptions">
                        <a href="javascript:void(0);" onclick="toggleSubMenu('leaveSubMenu')">
                            <i class="fa-regular fa-clipboard"></i><span>Leave</span>
                        </a>
                        <ul class="submenu ps-3 d-none" id="leaveSubMenu">
                            @if (role != RoleHelper.ToDbString(RoleEnum.Admin))
                            {
                                <li id="leaveSelf">
                                    <a asp-controller="Leave" asp-action="Index">Self</a>
                                </li>
                            }
                            <li id="leaveTeam">
                                <a asp-controller="Leave" asp-action="Team">Team</a>
                            </li>

                        </ul>
                    </li>
                    <li class="sidebaroptions" id="holiday">
                        <a asp-controller="Holiday" asp-action="Index"><i
                                class="fa-solid fa-calendar"></i><span>Holiday</span></a>
                    </li>
                    @if (role == RoleHelper.ToDbString(RoleEnum.Admin))
                    {
                        <li class="sidebaroptions" id="department">
                            <a asp-controller="Department" asp-action="Index"><i
                                    class="fa-brands fa-microsoft"></i><span>Department</span></a>
                        </li>
                    }
                    @if (role == RoleHelper.ToDbString(RoleEnum.Admin) || role ==
                                    RoleHelper.ToDbString(RoleEnum.SeniorManager) || role == RoleHelper.ToDbString(RoleEnum.Manager))
                    {
                        <li class="sidebaroptions" id="reportAnalytics">
                            <a asp-controller="ReportAnalytics" asp-action="Index"><i
                                    class="fa-solid fa-chart-pie"></i><span>Report & Analytics</span></a>
                        </li>
                    }
                </ul>
            </aside>
        }
        <main role="main" class="main-div @(user.Identity.IsAuthenticated ? "main-margin" : "")" id="mainBody">
            <partial name="_Notification" />
            @RenderBody()
        </main>
        <!-- logout modal -->
        <div class="modal fade" id="logout" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content w-75 p-3">
                    <div class=" d-flex flex-column align-items-center">

                        <p class="text-body-tertiary">Are you sure you want to Logout?</p>
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Auth" asp-action="Logout" class="btn sitebgcolor">Yes</a>
                        <a type="button" class="btn siteoutlinebtn" data-bs-dismiss="modal">No</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- delete alert modal -->
        <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="d-flex justify-content-between p-3">
                        <h5 class="text-body-tertiary" id="exampleModalLabel">Delete Confirmation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class=" d-flex flex-column align-items-center">
                        <p>Are you sure you want to delete this <span id="deleteTitle"></span>?</p>
                    </div>
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <a id="deleteConfirm" class="btn sitebgcolor">Yes</a>
                        <a class="btn siteoutlinebtn" data-bs-dismiss="modal">No</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            const sidebarMediaQuery = window.matchMedia('(min-width: 993px)');
            sidebarMediaQuery.addEventListener('change', () => {
                $("#mySidebar").toggleClass("hidden visible");
                $("#mainBody").toggleClass("main-margin");
            });
            $.ajax({
                url: "@Url.Action("GetUserData", "Dashboard")",
                type: "GET",
                success: function (response) {
                    $("#renderUser").html(response);
                }
            });
            $(".sidebaroptions").removeClass("activesidebar");
            document.getElementById('@ViewData["selected"]').classList.add("activesidebar");
        });
    </script>
    @* full calendar *@
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js'></script>
    @* google charts *@
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    @* data tables *@
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/buttons.print.min.js"></script>

    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
