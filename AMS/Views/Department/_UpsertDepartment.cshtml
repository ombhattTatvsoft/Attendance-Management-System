@model Entity.ViewModels.UpsertDepartmentVM;
<div class="modal-content">
  <div class="modal-header">
    <h5 class="modal-title">Department</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
  </div>
  <div class="modal-body">
    <input type="hidden" asp-for="DepartmentId" />
    <div class=" form-floating mb-3">
      <input asp-for="DepartmentName" type="text" class="form-control" id="floatingInput" placeholder="">
      <span asp-validation-for="DepartmentName" class="text-danger"></span>
      <label for="floatingInput">Name</label>
    </div>
  </div>
  <div class="modal-footer">
    <button type="submit" class="btn sitebgcolor">@(Model.DepartmentId==0?"Add":"Edit")</button>
    <button type="button" class="btn sitebgcolor ms-2" data-bs-dismiss="modal">Cancel</button>
  </div>
</div>
