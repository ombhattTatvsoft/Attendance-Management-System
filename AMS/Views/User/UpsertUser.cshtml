@using Entity.Enums
@model Entity.ViewModels.UpsertUserVM;
@{
    ViewData["Title"] = Model.UserId == 0 ? "Create User" : "Edit User";
}
<div class="content">
    <div class="row mx-sm-5 mx-2 pt-5">
        <div class="col-sm-6">
            <h3>@(Model.UserId == 0 ? "Add" : "Edit") User</h3>
        </div>
        <div class="col-sm-6 d-flex justify-content-sm-end">
            <a class="btn siteoutlinebtn" asp-action="Index">&lt; Back</a>
        </div>
        <form asp-action="UpsertUser" method="post" class="container bg-white mt-3 addnewuser shadow-lg rounded"
            enctype="multipart/form-data">
            <div class="row p-3 mt-2">
                <input type="hidden" asp-for="UserId" />
                <div class="col-md-6 mb-3">
                    <div class=" form-floating">
                        <input asp-for="Name" type="text" class="form-control" id="floatingInput" placeholder="">
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <label for="floatingInput">Name</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class=" form-floating">
                        <input asp-for="Email" type="email" class="form-control" id="floatingInput" placeholder="">
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <label for="floatingInput">Email</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class=" form-floating">
                        <input asp-for="Password" type="password" class="form-control" id="userPassword" placeholder="">
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <label for="floatingInput">Password</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class=" form-floating">
                        <select asp-for="Department" class="form-select" id="department"
                            asp-items="@(Html.GetEnumSelectList<Department>())">
                            <option value="">Select Department</option>
                        </select>
                        <span asp-validation-for="Department" class="text-danger"></span>
                        <label for="floatingInput">Department</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class=" form-floating">
                        <select asp-for="RoleId" class="form-select" id="roleId"
                            asp-items="@(Html.GetEnumSelectList<Entity.Enums.Role>().Where(r => int.Parse(r.Value) > 1))">
                            <option value="">Select Designation</option>
                        </select>
                        <span asp-validation-for="RoleId" class="text-danger"></span>
                        <label for="floatingInput">Designation</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <select asp-for="ManagerId" class="form-select" id="managerId">
                            <option value="">Select Reporting Person</option>
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger"></span>
                        <label for="floatingInput">Reporting person</label>
                    </div>
                </div>
                <div>
                    <button class="btn sitebgcolor" type="submit">@(Model.UserId == 0 ? "Add" : "Edit") User</button>
                    <a class="btn siteoutlinebtn ms-2" asp-action="Index">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $("#department,#roleId").change(function () {
            if ($("#roleId").val() == "2") {
                $("#managerId").parent().parent().hide();
            }
            else {
                $("#managerId").parent().parent().show();
                if ($("#department").val() != "" && $("#roleId").val() != "") {
                    $.ajax({
                        url: "@Url.Action("GetManagers", "User")",
                        type: "GET",
                        data: { departmentId: $("#department").val(), roleId: $("#roleId").val() },
                        success: function (data) {
                            $('#managerId').empty().append(new Option("Select Reporting Person", ""));
                            $.each(data, function (index, item) {
                                if (item.userId != @Model.UserId)
                                    $('#managerId').append(new Option(item.name + `(${item.roleName})`, item.userId));
                            });
                            if (@Model.UserId) {
                                if (@Model.Department == $("#department").val() && @Model.RoleId == $("#roleId").val())
                                    $('#managerId').val(@Model.ManagerId);
                            } else {
                                $('#managerId').val("");
                            }

                        }
                    });
                }
                else {
                    $('#managerId').empty().append(new Option("Select Reporting Person", ""));
                }
            }
        });
        $(document).ready(function () {
            $("#department").trigger("change");
            if (@Model.UserId != 0) {
                $("#userPassword").prop("disabled", true);
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}