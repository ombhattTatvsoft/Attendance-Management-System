@using System.Security.Claims
@using BLL.Helpers
@using Entity.Enums;
@model Entity.ViewModels.HolidayVM;
@{
  ViewData["Title"] = "Holiday";
  var role = User?.FindFirst(ClaimTypes.Role)?.Value.ToString();
}
<div class="content" id="holiday">
  <div class="row mx-sm-3 mx-2 pt-2">
    <div class="col-12 my-2">
      <h3 class="sitetxtcolor">Holiday</h3>
    </div>
    <div class="col-12 py-3">
      <div class="card p-3" id="holidayCalendar"></div>
    </div>
  </div>
</div>

<!-- Bootstrap Modal -->
@if (role == RoleHelper.ToDbString(RoleEnum.Admin))
{
  <div class="modal fade" id="holidayModal" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-dialog-centered">
      <form id="holidayForm" class="w-100">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Holiday</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" asp-for="HolidayId" />
            <div class=" form-floating mb-3">
              <input asp-for="HolidayName" type="text" class="form-control" id="floatingInput" placeholder="">
              <span asp-validation-for="HolidayName" class="text-danger"></span>
              <label for="floatingInput">Name</label>
            </div>
            <div class=" form-floating">
              <input asp-for="HolidayDate" type="date" class="form-control" id="floatingInput" placeholder="">
              <span asp-validation-for="HolidayDate" class="text-danger"></span>
              <label for="floatingInput">Date</label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="submit" class="btn sitebgcolor">Save</button>
            <button type="button" class="btn siteoutlinebtn ms-2" id="btnDelete">Delete</button>
          </div>
        </div>
      </form>
    </div>
  </div>
}

@section scripts {
  <script>
    var currentRole= '@role';
  </script>
  <script src="~/js/Holiday.js"></script>
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}