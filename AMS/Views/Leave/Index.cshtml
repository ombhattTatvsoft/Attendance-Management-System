@model Entity.Models.User;
@{
    ViewData["Title"] = "Leave";
}
<div class="content" id="leaveSelf">
    <div class="row mx-sm-3 mx-2 pt-2">
        <div class="col-12 my-2 d-flex align-items-center justify-content-between">
            <h3 class="sitetxtcolor">Leave</h3>
            <a class="btn sitebgcolor" id="addSelfLeave"> + Add</a>
        </div>
        <div class="col-12 h5 text-primary">
            Self
        </div>
        <div class="col-12 d-xxl-flex justify-content-between align-items-center">
            <div class="mb-3 d-flex flex-wrap gap-3 align-items-end">
                <div>
                    <label for="startDate" class="form-label fw-semibold">From Date</label>
                    <input id="startDate" class="form-control" type="date" />
                </div>
                <div>
                    <label for="endDate" class="form-label fw-semibold">To Date</label>
                    <input id="endDate" class="form-control" type="date" />
                </div>
                <div>
                    <label for="leaveStatus" class="form-label fw-semibold">Status</label>
                    <select class="form-select" id="leaveStatus">
                        <option value="All" selected>All</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div>
                    <button class="btn sitebgcolor" type="button" onclick="getLeaves()">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </div>
                <div>
                    <button class="btn siteoutlinebtn" onclick="refetchLeaves()" type="button">
                        <i class="bi bi-arrow-repeat me-1"></i></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="table-responsive bg-white shadow-lg rounded p-3" id="leaveTableContainer">
            </div>
        </div>
    </div>
</div>

@* leave upsert modal *@
<div class="modal fade" id="LeaveModal" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-dialog-centered">
        <form id="LeaveForm" class="w-100">

        </form>
    </div>
</div>

@section scripts {
    <script>
        var currentUserId = @Model.UserId;
        $(document).ready(function () {
            getLeaves();
        });
    </script>
    <script src="~/js/Leave.js">
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}