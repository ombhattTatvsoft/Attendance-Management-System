@model Entity.ViewModels.ForgotPasswordVM;
@{
    ViewData["Title"] = "Forgot Password Page";
}
<div class="container-fluid d-flex align-items-center justify-content-center vh-100">
    <div class="d-flex col-xxl-4 col-xl-6 col-md-8 col-11 flex-column align-items-center justify-content-center card bg-white rounded-4">
        <h4 class="mb-2 mt-4">Forgot Password</h4>
        <div class="col-10 mb-4">
            <p class="text-muted">Enter you email and we'll send you a link to reset your password.</p>
            <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                <div class="form-floating mb-3">
                    <input asp-for="Email" type="email" class="form-control" placeholder="">
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <label>Email</label>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <a class="links" asp-controller="Auth" asp-action="Index">Back to Login</a>
                    <button type="submit" class="btn sitebgcolor">Send</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}