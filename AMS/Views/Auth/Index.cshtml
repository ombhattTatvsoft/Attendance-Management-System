@model Entity.ViewModels.UserLoginVM;
@{
    ViewData["Title"] = "Login";
}
<div class="container-fluid d-flex align-items-center justify-content-center vh-100">
    <div
        class="d-flex col-xxl-4 col-xl-6 col-md-8 col-11 flex-column align-items-center justify-content-center card border-3 bg-white rounded-4">
        <div class="d-flex align-items-center gap-1 my-4 bg-dark text-white rounded-3 p-1">
            <img src="~/images/AMS_logo_2.png" class="img-fluid" style="height: 60px;" alt="">
            <span class="me-3 h3 mb-0">AMS</span>
        </div>
        <h4 class="mb-4">Login</h4>
        <div class="col-10 mb-4">
            <h5>Welcome,</h5>
            <form asp-controller="Auth" asp-action="Index" method="post">
                <div class="form-floating mb-3">
                    <input asp-for="Email" type="email" class="form-control" placeholder="">
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <label>Email</label>
                </div>
                <div class="form-floating mb-3 position-relative">
                    <input asp-for="Password" type="password" class="form-control" id="userPassword" placeholder="">
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <label>Password</label>
                    <i class="position-absolute passwordEyeIcon fa-regular fa-eye-slash" id="eyeicon4"
                        style="cursor: pointer;" onclick="togglePassword('userPassword','eyeicon4')"></i>
                </div>
                <div class="d-flex justify-content-between">
                    <div class="d-flex px-1">
                        <input type="checkbox" asp-for="Rememberme" class="form-check-input" id="">
                        <label class="form-check-label ms-2" for="exampleCheck1">Remember me</label>
                    </div>
                    <a class="links" asp-controller="Auth" asp-action="ForgotPassword">Forgot Password?</a>
                </div>
                <div class="my-2">
                    <button class="w-100 btn sitebgcolor" type="submit">Login</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}