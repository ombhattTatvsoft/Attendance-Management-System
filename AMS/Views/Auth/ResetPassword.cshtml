@model Entity.ViewModels.ResetPasswordVM;
@{
    ViewData["Title"] = "Reset Password";
}
<div class="container-fluid d-flex align-items-center justify-content-center vh-100">
    <div
        class="d-flex col-xxl-4 col-xl-6 col-md-8 col-11 flex-column align-items-center justify-content-center card border-3 bg-white rounded-4">
        <div class="d-flex align-items-center gap-1 my-4 bg-dark text-white rounded-3 p-1">
            <img src="~/images/AMS_logo_2.png" class="img-fluid" style="height: 60px;" alt="">
            <span class="me-3 h3 mb-0">AMS</span>
        </div>
        <h4 class="mb-4">Reset Password</h4>
        <div class="col-10 mb-4">
            <form asp-controller="Auth" asp-action="ResetPassword" method="post">
                <div class="form-floating mb-3 position-relative">
                    <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" placeholder=""> 
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <label>New Password</label>
                    <i class="position-absolute passwordEyeIcon fa-regular fa-eye-slash" id="eyeicon1"
                        style="cursor: pointer;" onclick="togglePassword('newPassword','eyeicon1')"></i>
                </div>
                <div class="form-floating mb-3 position-relative">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="cnewPassword" placeholder="">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <label>Confirm New Password</label>
                    <i class="position-absolute passwordEyeIcon fa-regular fa-eye-slash" id="eyeicon2"
                        style="cursor: pointer;" onclick="togglePassword('cnewPassword','eyeicon2')"></i>
                </div>
                <input asp-for="ResetCode" class="d-none">
                <div class="d-flex justify-content-end align-items-center">
                    <button type="submit" class="btn sitebgcolor">Send</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}